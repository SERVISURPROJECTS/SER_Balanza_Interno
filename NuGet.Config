<?xml version="1.0" encoding="utf-8"?>
<!--
  Config local de este proyecto (no afecta otros proyectos ni la config global del usuario).
  NuGet combina el packageSourceMapping de este archivo con el de la config global para la
  misma fuente ("nuget.org"), asi que solo se agregan los patrones que faltan para poder
  publicar self-contained (necesita los paquetes de runtime de .NET, que la config global
  no tenia habilitados desde nuget.org).
-->
<configuration>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Microsoft.NETCore.App.Runtime.win-x64" />
      <package pattern="Microsoft.WindowsDesktop.App.Runtime.win-x64" />
      <package pattern="Microsoft.AspNetCore.App.Runtime.win-x64" />
      <package pattern="SQLitePCLRaw.*" />
      <package pattern="System.Security.Cryptography.ProtectedData" />
      <package pattern="runtime.any.*" />
      <package pattern="Microsoft.NETCore.Platforms" />
      <package pattern="Microsoft.NETCore.Targets" />
      <package pattern="System.Private.Uri" />
    </packageSource>
  </packageSourceMapping>
</configuration>
